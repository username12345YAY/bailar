// server.js  (ES module version)
import express from "express";
import fetch from "node-fetch";
import path from "path";
import { fileURLToPath } from "url";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const app = express();
const PORT = process.env.PORT || 3000;
app.use(express.json());

const AGENT_ID = process.env.CHATBASE_AGENT_ID;

if (!AGENT_ID) {
  console.error("❌ CHATBASE_AGENT_ID not set in environment variables.");
  process.exit(1);
}

// serve chat.html
app.use(express.static(path.join(__dirname)));

// direct call to Chatbase
app.post("/help", async (req, res) => {
  try {
    console.log("🟢 Incoming message:", req.body);

    const response = await fetch(`https://www.chatbase.co/api/agent/${AGENT_ID}/message`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(req.body),
    });

    const data = await response.json();
    console.log("🟣 Chatbase responded:", JSON.stringify(data, null, 2));

    res.status(response.status).json(data);
  } catch (err) {
    console.error("🔴 Error contacting Chatbase:", err);
    res.status(500).json({ error: "Failed to reach Chatbase API" });
  }
});

app.get("/", (req, res) => {
  res.send(`
    <h1>✅ Sagitarius Proxy Server Running</h1>
    <p>Visit <a href="/chat.html" target="_blank">Chatbox</a></p>
  `);
});

app.listen(PORT, () => {
  console.log(`🚀 Sagitarius proxy active on port ${PORT}`);
});
